# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Node / pnpm
node_modules/
.pnpm-store/
dist/
*.local

# Tools
.tools/

# IDE
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Thumbs.db
.DS_Store

# 本地密钥（含 ASSISTANT_LLM_API_KEY 等，绝不入库）
.env
.env.*

# Logs
*.log

# 现场照片上传目录（运行时产物，由 app.file.upload-dir 指定）
uploads/

# 过程性 / 开发 / 计划文档一律不入库（见 AGENTS.md §1）：docs/ 只留在磁盘。
# 历史入库的 17 个文件已 `git rm -r --cached`，磁盘未删。
docs/

# 视觉伴侣（brainstorming 的 mockup 产物与过程记录，本地会话临时文件）
.superpowers/

# 探针目录：只入库**可复跑的回归探针**及其公共模块，
# 其余（诊断/截图/迁移/生成/一次性核对）留在磁盘，避免 git status 噪声。
.scratch/*
!.scratch/assert-*.mjs
!.scratch/cdp-raw.mjs
!.scratch/measure.mjs
!.scratch/probe-*.mjs
!.scratch/table-dom.mjs
!.scratch/verify-tabs.mjs
!.scratch/check-*.mjs
!.scratch/census-*.mjs
!.scratch/narrow-public.mjs
!.scratch/narrow-walkthrough.mjs
!.scratch/make-pwa-icons.mjs

# 工具目录（会话过程转储与记忆，非产物）
.workbuddy/
.zcode/

# Maven 测试/运行的临时目录：受限沙箱下 java.io.tmpdir 必须落在工作区内，
# 否则 ImageIO 相关用例会报 Unable to create tempDir / AccessDeniedException。
.tmp-java/

