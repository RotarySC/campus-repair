# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Node / pnpm
node_modules/
.pnpm-store/
dist/
*.local

# Tools
.tools/

# IDE
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
Thumbs.db
.DS_Store

# 本地密钥（含 ASSISTANT_LLM_API_KEY 等，绝不入库）
.env
.env.*

# Logs
*.log

# 现场照片上传目录（运行时产物，由 app.file.upload-dir 指定）
uploads/

# 文档目录（按用户要求排除在 git 之外）
# ⚠️ 注意：本目录下**已被跟踪**的文件不受影响（gitignore 只作用于未跟踪文件），
#    它们仍会出现在 git status 里。要让它们真正退出跟踪需 `git rm -r --cached docs`。
docs/

# 视觉伴侣（brainstorming 的 mockup 产物与过程记录，本地会话临时文件）
.superpowers/

# 探针的**临时产物**：截图与 stdout 存档。
# 探针脚本本身（.scratch/*.mjs）是入库的——它们是可复跑的判据；
# 但它们吐出来的图与日志是**一次性的观测**，入库只会让 git status 长满噪声。
.scratch/v7-shots/
.scratch/v3-shots/
.scratch/v8-shots/
.scratch/v9-shots/
.scratch/v10-shots/
.scratch/probe-out*.txt

# Maven 测试/运行的临时目录（沙箱下 java.io.tmpdir 必须落在工作区内，
# 见 AGENTS.md §2.1：不设它会报 Unable to create tempDir / AccessDeniedException）
.tmp-java/

